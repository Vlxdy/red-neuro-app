{
  "asyncapi": "2.5.0",
  "info": {
    "title": "AsyncAPI - WebSockets",
    "description": "Documentación de eventos WebSocket",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": {
    "ws-gateway": {
      "url": "ws://localhost:4500",
      "protocol": "socket.io"
    }
  },
  "components": {
    "schemas": {
      "EtiquetaAsociacionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador de una etiqueta existente. Use este campo o envíe nombre y colorHex",
            "example": "tag-urgente"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre de la etiqueta a crear o reutilizar si ya existe",
            "example": "Prioritaria"
          },
          "colorHex": {
            "type": "string",
            "description": "Color en hexadecimal, requerido cuando se crea una nueva etiqueta",
            "example": "#ff3366"
          }
        }
      },
      "MensajeCitaDto": {
        "type": "object",
        "properties": {
          "detalle": {
            "type": "string",
            "description": "Detalle o motivo de la cita",
            "example": "Control nutricional mensual"
          },
          "fechaInicio": {
            "type": "string",
            "description": "Fecha de inicio (ISO)",
            "example": "2024-06-15T10:00:00Z"
          },
          "fechaFin": {
            "type": "string",
            "description": "Fecha de fin (ISO)",
            "example": "2024-06-15T11:00:00Z"
          },
          "medicoId": {
            "type": "string",
            "description": "Identificador del médico responsable",
            "example": "42"
          },
          "agrupadorId": {
            "type": "string",
            "description": "Agrupador asociado (ambiente)",
            "example": "grp-1"
          },
          "etiquetas": {
            "description": "Etiquetas a asociar, permite enviar ids existentes o nombre/colorHex para crear la etiqueta si no existe",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EtiquetaAsociacionDto"
            }
          }
        },
        "required": [
          "detalle",
          "fechaInicio",
          "fechaFin",
          "medicoId"
        ]
      },
      "MensajeEstadoCitaDto": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "INACTIVO",
              "BORRADOR",
              "SOLICITADA",
              "CONFIRMADA",
              "EN_CURSO",
              "COMPLETADA",
              "NO_ASISTIO",
              "CANCELADA",
              "RECHAZADA"
            ],
            "description": "Nuevo estado de la cita"
          },
          "comentario": {
            "type": "string",
            "description": "Comentario opcional para el cambio de estado"
          },
          "id": {
            "type": "string",
            "description": "Identificador de la cita",
            "example": "cita-123"
          }
        },
        "required": [
          "estado",
          "id"
        ]
      },
      "MensajeReprogramarCitaDto": {
        "type": "object",
        "properties": {
          "fechaInicio": {
            "type": "string",
            "description": "Nueva fecha de inicio",
            "example": "2024-06-20T12:00:00Z"
          },
          "fechaFin": {
            "type": "string",
            "description": "Nueva fecha de fin",
            "example": "2024-06-20T13:00:00Z"
          },
          "comentario": {
            "type": "string",
            "description": "Comentario o motivo de la reprogramación"
          },
          "id": {
            "type": "string",
            "description": "Identificador de la cita",
            "example": "cita-123"
          }
        },
        "required": [
          "fechaInicio",
          "fechaFin",
          "id"
        ]
      },
      "MensajeCancelarCitaDto": {
        "type": "object",
        "properties": {
          "comentario": {
            "type": "string",
            "description": "Motivo de cancelación"
          },
          "id": {
            "type": "string",
            "description": "Identificador de la cita",
            "example": "cita-123"
          }
        },
        "required": [
          "id"
        ]
      },
      "SystemPingDto": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "example": "frontend-app",
            "description": "Identificador del cliente que realiza el ping"
          },
          "version": {
            "type": "string",
            "example": "1.0.0",
            "description": "Versión de la app cliente"
          }
        },
        "required": [
          "clientId",
          "version"
        ]
      }
    }
  },
  "channels": {
    "citas:create": {
      "subscribe": {
        "summary": "Crear cita vía socket",
        "description": "Permite al cliente crear citas y recibir la confirmación broadcast",
        "message": {
          "name": "CrearCitaSocket",
          "payload": {
            "$ref": "#/components/schemas/MensajeCitaDto"
          }
        }
      }
    },
    "citas:created": {
      "publish": {
        "message": {
          "name": "CitaCreada",
          "payload": {
            "$ref": "#/components/schemas/MensajeCitaDto"
          }
        }
      }
    },
    "citas:estado": {
      "subscribe": {
        "summary": "Cambiar estado de cita",
        "message": {
          "name": "ActualizarEstadoCita",
          "payload": {
            "$ref": "#/components/schemas/MensajeEstadoCitaDto"
          }
        }
      }
    },
    "citas:estado-actualizado": {
      "publish": {
        "message": {
          "name": "CitaEstadoActualizado",
          "payload": {
            "$ref": "#/components/schemas/MensajeEstadoCitaDto"
          }
        }
      }
    },
    "citas:reprogramar": {
      "subscribe": {
        "summary": "Reprograma una cita",
        "message": {
          "name": "ReprogramarCita",
          "payload": {
            "$ref": "#/components/schemas/MensajeReprogramarCitaDto"
          }
        }
      }
    },
    "citas:reprogramada": {
      "publish": {
        "message": {
          "name": "CitaReprogramada",
          "payload": {
            "$ref": "#/components/schemas/MensajeReprogramarCitaDto"
          }
        }
      }
    },
    "citas:cancelar": {
      "subscribe": {
        "summary": "Cancela una cita",
        "message": {
          "name": "CancelarCita",
          "payload": {
            "$ref": "#/components/schemas/MensajeCancelarCitaDto"
          }
        }
      }
    },
    "citas:cancelada": {
      "publish": {
        "message": {
          "name": "CitaCancelada",
          "payload": {
            "$ref": "#/components/schemas/MensajeCancelarCitaDto"
          }
        }
      }
    },
    "system:ping": {
      "subscribe": {
        "summary": "El cliente prueba la conexión con el sistema",
        "message": {
          "name": "SystemPing",
          "payload": {
            "$ref": "#/components/schemas/SystemPingDto"
          }
        }
      }
    }
  }
}